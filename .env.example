# STT provider mode.
# - local: use the bundled WhisperX service (default)
# - openai-compatible: proxy /v1/audio/transcriptions to STT_UPSTREAM_BASE_URL/audio/transcriptions
STT_PROVIDER=local

# OpenAI-compatible upstream for STT_PROVIDER=openai-compatible.
# Example OpenRouter base URL: https://openrouter.ai/api/v1
STT_UPSTREAM_BASE_URL=
STT_UPSTREAM_API_KEY=
# Optional. If empty, the incoming request model (usually whisper-1) is forwarded.
STT_UPSTREAM_MODEL=
# auto picks OpenRouter's JSON/base64 transcription schema for openrouter.ai;
# for Voxtral audio-input chat models it uses OpenRouter chat audio. Use
# openai-multipart for providers that accept OpenAI's multipart file upload.
STT_UPSTREAM_REQUEST_FORMAT=auto

# HuggingFace token for WhisperX speaker diarization in local STT mode (optional but recommended)
HF_TOKEN=

# OpenAI-compatible Chat Completions provider for the LLM proxy.
# Examples:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Deprecated: kept only for older local env files. Use LLM_API_KEY instead.
GROQ_API_KEY=
# ElevenLabs API key for TTS service (required for production TTS)
ELEVENLABS_API_KEY=

# Optional ElevenLabs voice id/name settings. Voice ids are preferred; names are resolved via /v1/voices.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE=
ELEVENLABS_VOICE_NAME=
ELEVENLABS_EN_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_EN_VOICE=
ELEVENLABS_EN_VOICE_NAME=
ELEVENLABS_AR_VOICE_ID=EGYKu1CV0vikeTYK5zoc
ELEVENLABS_AR_VOICE=
ELEVENLABS_AR_VOICE_NAME=
