# HuggingFace token for WhisperX speaker diarization (optional but recommended)
HF_TOKEN=

# OpenAI-compatible Chat Completions provider for the LLM proxy.
# Examples:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Deprecated: kept only for older local env files. Use LLM_API_KEY instead.
GROQ_API_KEY=
# ElevenLabs API key for TTS service (required for production TTS)
ELEVENLABS_API_KEY=

# Optional ElevenLabs voice id/name settings. Voice ids are preferred; names are resolved via /v1/voices.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE=
ELEVENLABS_VOICE_NAME=
ELEVENLABS_EN_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_EN_VOICE=
ELEVENLABS_EN_VOICE_NAME=
ELEVENLABS_AR_VOICE_ID=EGYKu1CV0vikeTYK5zoc
ELEVENLABS_AR_VOICE=
ELEVENLABS_AR_VOICE_NAME=
