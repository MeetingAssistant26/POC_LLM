# STT provider mode.
# - local: use the bundled WhisperX service
# - openai-compatible: proxy POST /v1/audio/transcriptions to an OpenAI-compatible upstream
STT_PROVIDER=openai-compatible

# OpenAI-compatible upstream for STT_PROVIDER=openai-compatible.
# OpenRouter example: https://openrouter.ai/api/v1
STT_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
STT_UPSTREAM_API_KEY=
# Optional. If empty, the incoming request model (usually whisper-1) is forwarded.
# Gemini on OpenRouter: google/gemini-3.1-flash-lite
STT_UPSTREAM_MODEL=google/gemini-3.1-flash-lite
# Request routing (public endpoint stays /v1/audio/transcriptions):
# - openrouter-chat-audio: OpenRouter Chat Completions (/chat/completions) with input_audio
#   (required for google/gemini-* models)
# - openrouter-json: OpenRouter transcription JSON (/audio/transcriptions) with base64 input_audio
# - openai-multipart: multipart file upload to /audio/transcriptions
# - auto: on openrouter.ai, picks chat-audio for google/gemini-* and non-transcribe Voxtral models
STT_UPSTREAM_REQUEST_FORMAT=openrouter-chat-audio
# Optional upstream language override. Empty forwards the caller's language;
# auto/detect omits language so upstream STT can auto-detect; ar/en/etc force a language.
STT_UPSTREAM_LANGUAGE=auto

# HuggingFace token for WhisperX speaker diarization in local STT mode (optional but recommended)
HF_TOKEN=

# OpenAI-compatible Chat Completions provider for the LLM proxy.
# Examples:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Deprecated: kept only for older local env files. Use LLM_API_KEY instead.
GROQ_API_KEY=
# ElevenLabs API key for TTS service (required for production TTS)
ELEVENLABS_API_KEY=

# Optional ElevenLabs voice id/name settings. Voice ids are preferred; names are resolved via /v1/voices.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE=
ELEVENLABS_VOICE_NAME=
ELEVENLABS_EN_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_EN_VOICE=
ELEVENLABS_EN_VOICE_NAME=
ELEVENLABS_AR_VOICE_ID=EGYKu1CV0vikeTYK5zoc
ELEVENLABS_AR_VOICE=
ELEVENLABS_AR_VOICE_NAME=
